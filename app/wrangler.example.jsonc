// Copied to wrangler.jsonc by `make setup` (git-ignored). Fill in the Access values
// after enabling Cloudflare Access on the workers.dev route - see README.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rv-plans",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Preview URLs are not covered by the workers.dev Access policy; keep them off.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "CHATS", "id": "REPLACE_WITH_KV_ID" }],
  "vars": {
    // Cloudflare Access: team domain (e.g. "myteam.cloudflareaccess.com") and the
    // Application Audience (AUD) tag from the workers.dev Access application.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
